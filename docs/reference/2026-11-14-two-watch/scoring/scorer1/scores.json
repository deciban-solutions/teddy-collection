   "makes_sense_together": 3,
   "beaten_path": 3,
   "daily_driver": 5,
   "sensible_spice": 3,
   "everyday_livability": 4,
   "expert_rank": 4,
   "rationale": "The 37 mm Lake Suwa Spring Drive is an outstanding grab-and-go anchor for this wrist. The Breitling Datora brings copper-dial warmth and a chronograph, but at 15.35 mm on leather with a triple calendar needing resets it is a thick, fussy second watch whose role (dressier/dinner) the Grand Seiko largely covers already."
  },
  "PAIR-X": {
   "differentiation": 5,
   "coherence_expert": 3,
   "anchor_strength": 2,
   "tension_point": 4,
   "gap_test": 4,
   "wear_balance": 3,
   "makes_sense_together": 2,
   "beaten_path": 2,
   "daily_driver": 2,
   "sensible_spice": 3,
   "everyday_livability": 2,
   "expert_rank": 6,
   "rationale": "Strongly differentiated: a vintage-style hand-wound steel chronograph on fabric against a 44 mm gold perpetual calendar. But the gold Portugieser is large, heavy and suits only a few formal days, leaving a hand-wound watch on a fabric strap to carry roughly 300 days including swims; no bracelet, no robust daily anchor. Admirable horology, poor fit to 'serve you every single day'."
  },
  "PAIR-Y": {
   "differentiation": 3,
   "coherence_expert": 3,
